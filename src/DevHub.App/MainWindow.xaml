<Window
    x:Class="DevHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DevHub">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the whole row is the drag region (SetTitleBar in code-behind). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center"
                Margin="16,0,0,0">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" />
                <TextBlock
                    Text="DevHub"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
