<Page
    x:Class="DevHub.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid>
        <ScrollViewer>
        <Grid>
        <!-- Sky backdrop: gradient fading downward (starry at night), with the blurred
             sun/moon and current conditions in the top-left. Scrolls with the content. -->
        <canvas:CanvasControl
            x:Name="SkyDecor"
            Height="380"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Draw="SkyDecor_Draw" />

        <StackPanel Margin="36,24,36,24" Spacing="24">

            <!-- Update available -->
            <InfoBar
                Severity="Informational"
                IsOpen="{x:Bind Updates.HasUpdate, Mode=OneWay}"
                Title="{x:Bind Updates.BannerTitle, Mode=OneWay}"
                Message="{x:Bind Updates.StatusText, Mode=OneWay}"
                CloseButtonClick="UpdateBanner_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Install now"
                        Command="{x:Bind Updates.InstallCommand}"
                        IsEnabled="{x:Bind Updates.CanInstallNow, Mode=OneWay}" />
                </InfoBar.ActionButton>
                <StackPanel Margin="0,0,0,12" Spacing="8">
                    <HyperlinkButton
                        Padding="0"
                        Content="Release notes"
                        Command="{x:Bind Updates.OpenReleasePageCommand}" />
                    <ProgressBar
                        Maximum="100"
                        Value="{x:Bind Updates.DownloadPercent, Mode=OneWay}"
                        Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}" />
                </StackPanel>
            </InfoBar>

            <!-- Greeting + weather -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.TodayText}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    MinWidth="320"
                    Padding="20,14"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.HasWeather, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="36"
                            Text="{x:Bind ViewModel.WeatherEmoji, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.WeatherTempText, Mode=OneWay}" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.WeatherConditionText, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.WeatherPlaceText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.WeatherRangeText, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.WeatherDetailText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="System" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,3"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.OsText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,3"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Border
                        Grid.Column="0"
                        MinHeight="190"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="CPU" />
                            <Grid HorizontalAlignment="Center">
                                <ProgressRing
                                    Width="88"
                                    Height="88"
                                    IsIndeterminate="False"
                                    Maximum="100"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CpuPercentText, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CpuDetailText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border
                        Grid.Column="1"
                        MinHeight="190"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="MEMORY" />
                            <Grid HorizontalAlignment="Center">
                                <ProgressRing
                                    Width="88"
                                    Height="88"
                                    IsIndeterminate="False"
                                    Maximum="100"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.MemoryPercentText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.MemoryDetailText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- GPU -->
                    <Border
                        Grid.Column="2"
                        MinHeight="190"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="GPU" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                <FontIcon
                                    FontSize="28"
                                    Glyph="&#xE7F4;"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.GpuText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OS -->
                    <Border
                        Grid.Column="3"
                        MinHeight="190"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="SYSTEM" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                <FontIcon
                                    FontSize="28"
                                    Glyph="&#xE770;"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.OsName, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.OsBuildText, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Drives -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.DriveStats, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UsageStat">
                            <Border
                                Width="300"
                                Padding="16"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="&#xEDA2;"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind PercentText}" />
                                    </Grid>
                                    <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind DetailText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Tool updates -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tools" />
                <Border
                    Padding="16"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Checking -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Environments.IsLoading, Mode=OneWay}">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Environments.IsLoading, Mode=OneWay}" />
                            <TextBlock Text="Checking for tool updates…" />
                        </StackPanel>

                        <!-- Updates available -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Environments.HasUpdates, Mode=OneWay}">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE896;"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.Environments.UpdateCount, Mode=OneWay}" /><Run Text=" tool update(s) available" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Up to date -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Environments.IsUpToDate, Mode=OneWay}">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE73E;"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock VerticalAlignment="Center" Text="All tools are up to date" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Update all"
                                Command="{x:Bind ViewModel.Environments.UpdateAllCommand}"
                                Visibility="{x:Bind ViewModel.Environments.HasUpdates, Mode=OneWay}" />
                            <Button Content="Open Environments" Click="OpenEnvironments_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Your work (feeds from the connected forges) -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Your work" />
                <Border
                    Padding="12"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">

                        <SelectorBar
                            x:Name="WorkFeedBar"
                            Margin="4,0,0,4"
                            SelectionChanged="WorkFeedBar_SelectionChanged"
                            Visibility="{x:Bind ViewModel.ShowFeedBar, Mode=OneWay}">
                            <SelectorBarItem Text="{x:Bind ViewModel.ReviewsFeedLabel, Mode=OneWay}" IsSelected="True" />
                            <SelectorBarItem Text="{x:Bind ViewModel.MyPrsFeedLabel, Mode=OneWay}" />
                            <SelectorBarItem Text="{x:Bind ViewModel.IssuesFeedLabel, Mode=OneWay}" />
                        </SelectorBar>

                        <!-- No account connected -->
                        <Grid ColumnSpacing="12" Padding="4" Visibility="{x:Bind ViewModel.ShowConnectHint, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Connect your GitHub or GitLab account to see pull requests waiting for your review."
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="Open Settings"
                                Click="OpenSettings_Click" />
                        </Grid>

                        <!-- Loading -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Padding="4"
                            Visibility="{x:Bind ViewModel.IsLoadingWork, Mode=OneWay}">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingWork, Mode=OneWay}" />
                            <TextBlock Text="Checking your work across forges…" />
                        </StackPanel>

                        <!-- All clear -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Padding="4"
                            Visibility="{x:Bind ViewModel.ShowWorkAllClear, Mode=OneWay}">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE73E;"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WorkEmptyText, Mode=OneWay}" />
                        </StackPanel>

                        <!-- The selected feed -->
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.WorkItems}"
                            Visibility="{x:Bind ViewModel.HasWorkItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ForgeItemViewModel">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="{x:Bind WebUrl}"
                                        Click="OpenReview_Click"
                                        ToolTipService.ToolTip="{x:Bind WebUrl}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Octicons: git-pull-request / issue-opened (MIT, © GitHub) -->
                                            <Viewbox
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsPullRequest}">
                                                <Path
                                                    Fill="{x:Bind IconBrush}"
                                                    Data="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z" />
                                            </Viewbox>
                                            <Viewbox
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsIssue}">
                                                <Path
                                                    Fill="{x:Bind IconBrush}"
                                                    Data="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z" />
                                            </Viewbox>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{x:Bind IsDraft}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="Draft" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind MetaText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ForgeName}" />
                                            <FontIcon
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Glyph="&#xE8A7;"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recent projects -->
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recent projects" />

                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Projects you open will show up here."
                    Visibility="{x:Bind ViewModel.HasNoRecentProjects, Mode=OneWay}" />

                <GridView
                    ItemsSource="{x:Bind ViewModel.RecentProjects}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasRecentProjects, Mode=OneWay}">
                    <!-- Bare container: the Button below draws its own rounded hover/press
                         chrome, so the GridViewItem must not add a rectangle on top. -->
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,4,12,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectViewModel">
                            <Button
                                Width="320"
                                Padding="16"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Tag="{x:Bind}"
                                Click="RecentProject_Click">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <FontIcon
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Glyph="&#xE9A6;"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Visibility="{x:Bind IsGitRepository}" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Path}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{x:Bind Badges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:Badge">
                                                <Border
                                                    Padding="7,2"
                                                    CornerRadius="8"
                                                    Background="{x:Bind Brush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Image
                                                            Width="11"
                                                            Height="11"
                                                            VerticalAlignment="Center"
                                                            Source="{x:Bind Icon}"
                                                            Visibility="{x:Bind HasIcon}" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind Text}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

        </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
