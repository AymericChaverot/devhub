<Page
    x:Class="DevHub.App.Views.EnvironmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedTools" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Margin="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="Env_Title" Style="{StaticResource TitleTextBlockStyle}" Text="Environments" />
            <TextBlock
                x:Uid="Env_Subtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Install development environments with one click. Installations run through winget." />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <AutoSuggestBox
                x:Uid="Env_Search"
                Width="320"
                VerticalAlignment="Center"
                PlaceholderText="Search tools"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            <ComboBox
                MinWidth="180"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.CategoryOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
            <ComboBox
                MinWidth="150"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.StatusOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" />
            <Button
                VerticalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.UpdateAllLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.UpdateAllCommand}"
                Visibility="{x:Bind ViewModel.HasUpdates, Mode=OneWay}" />
            <ProgressRing
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            CloseButtonClick="ErrorInfoBar_CloseButtonClick" />

        <TextBlock
            x:Uid="Env_NoResults"
            Grid.Row="3"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No tools match the current search or filters."
            Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}" />

        <GridView
            x:Name="ToolsGrid"
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind GroupedTools.View, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="False">

            <!-- Margin lives on the container so the hover/press chrome hugs the card exactly. -->
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,4,8,4" />
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:PackageGroup">
                            <TextBlock
                                Margin="0,12,0,4"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Category}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolCardViewModel">
                    <Grid
                        Width="320"
                        Height="200"
                        Padding="16"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="8"
                                Background="{x:Bind IconBrush}">
                                <Grid>
                                    <Image
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind IconImage}"
                                        Visibility="{x:Bind HasIconImage}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind IconText}"
                                        Visibility="{x:Bind ShowsMonogram}" />
                                </Grid>
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind DisplayName}" />

                            <Button
                                x:Uid="Common_UpdateButton"
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Padding="10,4"
                                Content="Update"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind SelectedVariant.UpdateHintText, Mode=OneWay}"
                                Command="{x:Bind SelectedVariant.UpdateCommand, Mode=OneWay}"
                                Visibility="{x:Bind SelectedVariant.CanUpdate, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description}"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="3" />

                        <ComboBox
                            Grid.Row="2"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Variants}"
                            SelectedItem="{x:Bind SelectedVariant, Mode=TwoWay}"
                            Visibility="{x:Bind HasMultipleVariants}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolVariantViewModel">
                                    <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Glyph="&#xE823;"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Visibility="{x:Bind SelectedVariant.IsQueued, Mode=OneWay}" />
                                    <ProgressRing
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind SelectedVariant.IsWorking, Mode=OneWay}"
                                        Visibility="{x:Bind SelectedVariant.IsWorking, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SelectedVariant.StatusText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind SelectedVariant.UpdateHintText, Mode=OneWay}"
                                    Visibility="{x:Bind SelectedVariant.CanUpdate, Mode=OneWay}" />
                                <ProgressBar
                                    IsIndeterminate="True"
                                    ShowPaused="{x:Bind SelectedVariant.IsQueued, Mode=OneWay}"
                                    Visibility="{x:Bind SelectedVariant.IsBusy, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                x:Uid="Common_InstallButton"
                                Grid.Column="1"
                                Content="Install"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind SelectedVariant.InstallCommand, Mode=OneWay}"
                                Visibility="{x:Bind SelectedVariant.CanInstall, Mode=OneWay}" />
                            <Button
                                x:Uid="Common_UninstallButton"
                                Grid.Column="1"
                                Content="Uninstall"
                                Command="{x:Bind SelectedVariant.UninstallCommand, Mode=OneWay}"
                                Visibility="{x:Bind SelectedVariant.CanUninstall, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
