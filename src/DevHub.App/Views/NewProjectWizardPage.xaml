<Page
    x:Class="DevHub.App.Views.NewProjectWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels"
    xmlns:models="using:DevHub.Core.Models">

    <Grid Margin="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button
                x:Uid="Wizard_BackTip"
                Click="BackButton_Click"
                ToolTipService.ToolTip="Back to projects">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock x:Uid="Wizard_Title" Style="{StaticResource TitleTextBlockStyle}" Text="New Project" />
        </StackPanel>

        <!-- Step indicator -->
        <TextBlock
            Grid.Row="1"
            Margin="0,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" />

        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            CloseButtonClick="ErrorInfoBar_CloseButtonClick" />

        <ScrollViewer Grid.Row="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
          <Grid>

            <!-- Step 1: metadata -->
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Left"
                Spacing="20"
                Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Wizard_NameLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                    <TextBox
                        PlaceholderText="my-app"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Wizard_PathLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Path" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Path, Mode=TwoWay}" />
                        <Button
                            x:Uid="Wizard_Browse"
                            Grid.Column="1"
                            Click="Browse_Click"
                            Content="Browse…" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Wizard_IdeLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Default IDE" />
                    <ComboBox
                        MinWidth="280"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{x:Bind ViewModel.AvailableIdes}"
                        PlaceholderText="No IDE detected"
                        SelectedItem="{x:Bind ViewModel.SelectedIde, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Step 2: stack -->
            <StackPanel
                MaxWidth="640"
                HorizontalAlignment="Left"
                Spacing="16"
                Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <RadioButton
                        x:Name="NoStackRadio"
                        x:Uid="Wizard_NoStack"
                        Checked="NoStackRadio_Checked"
                        Content="No stack (empty folder)"
                        GroupName="Template" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Templates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectTemplate">
                                <RadioButton
                                    HorizontalContentAlignment="Stretch"
                                    Checked="TemplateRadio_Checked"
                                    GroupName="Template"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Language}" />
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Wizard_CommandLabel" Style="{StaticResource CaptionTextBlockStyle}" Text="Command" />
                    <Border
                        Padding="10,8"
                        CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <TextBlock
                            FontFamily="Cascadia Mono,Consolas"
                            Text="{x:Bind ViewModel.ScaffoldCommandPreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <InfoBar
                    x:Uid="Wizard_RuntimeWarningInfoBar"
                    Severity="Warning"
                    IsOpen="{x:Bind ViewModel.ShowRuntimeWarning, Mode=OneWay}"
                    Title="Runtime not found"
                    Message="This template needs a runtime that isn't installed.">
                    <InfoBar.ActionButton>
                        <HyperlinkButton x:Uid="Wizard_InstallViaEnvironments" Click="InstallViaEnvironments_Click" Content="Install via Environments" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Step 3: git & forge -->
            <StackPanel
                MaxWidth="640"
                HorizontalAlignment="Left"
                Spacing="20"
                Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
                <CheckBox
                    x:Uid="Wizard_InitGit"
                    Content="Initialize Git repository"
                    IsChecked="{x:Bind ViewModel.InitializeGit, Mode=TwoWay}" />

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Wizard_RemoteLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Remote repository" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton
                            x:Name="RemoteNoneRadio"
                            x:Uid="Wizard_RemoteNone"
                            Checked="RemoteModeRadio_Checked"
                            Content="None"
                            GroupName="RemoteMode"
                            Tag="None" />
                        <RadioButton
                            x:Name="RemotePasteRadio"
                            x:Uid="Wizard_RemotePaste"
                            Checked="RemoteModeRadio_Checked"
                            Content="Paste existing URL"
                            GroupName="RemoteMode"
                            Tag="PasteUrl" />
                        <RadioButton
                            x:Name="RemoteForgeRadio"
                            x:Uid="Wizard_RemoteForge"
                            Checked="RemoteModeRadio_Checked"
                            Content="Create via connected account"
                            GroupName="RemoteMode"
                            Tag="CreateViaForge" />
                    </StackPanel>

                    <TextBox
                        x:Uid="Wizard_RemoteUrlBox"
                        PlaceholderText="https://github.com/user/my-repo.git"
                        Text="{x:Bind ViewModel.RemoteUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsRemotePasteUrl, Mode=OneWay}" />

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsRemoteCreateViaForge, Mode=OneWay}">
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasForgeAccounts, Mode=OneWay}">
                            <ComboBox
                                MinWidth="280"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.ForgeAccounts}"
                                PlaceholderText="Choose an account"
                                SelectedItem="{x:Bind ViewModel.SelectedForgeAccount, Mode=TwoWay}" />
                            <TextBox
                                x:Uid="Wizard_NewRepoNameBox"
                                PlaceholderText="Repository name"
                                Text="{x:Bind ViewModel.NewRepoName, Mode=TwoWay}" />
                            <CheckBox
                                x:Uid="Wizard_RepoPrivate"
                                Content="Private repository"
                                IsChecked="{x:Bind ViewModel.NewRepoIsPrivate, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="Wizard_NoForgeAccounts"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No connected accounts. Connect one from Settings first."
                            Visibility="{x:Bind ViewModel.NoForgeAccounts, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <CheckBox
                    x:Uid="Wizard_PublishInitial"
                    Content="Publish initial commit and push to remote"
                    IsChecked="{x:Bind ViewModel.PublishInitialCommit, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.HasRemote, Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- Live log / progress, shown once Create has started -->
        <StackPanel
            Grid.Row="4"
            Margin="0,12,0,0"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}" />
            </StackPanel>
            <Border
                MaxHeight="160"
                Padding="10,8"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Cascadia Mono,Consolas"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="5" Margin="0,16,0,24" Orientation="Horizontal" Spacing="8">
            <Button
                x:Uid="Wizard_BackStep"
                Command="{x:Bind ViewModel.BackCommand}"
                Content="Back"
                Visibility="{x:Bind ViewModel.ShowBackButton, Mode=OneWay}" />
            <Button
                x:Uid="Wizard_NextStep"
                Command="{x:Bind ViewModel.NextCommand}"
                Content="Next"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.ShowNextButton, Mode=OneWay}" />
            <Button
                x:Uid="Wizard_Create"
                Command="{x:Bind ViewModel.CreateCommand}"
                Content="Create"
                IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsLastStep, Mode=OneWay}" />
            <Button
                x:Uid="Wizard_CancelButton"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</Page>
