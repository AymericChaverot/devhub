<Page
    x:Class="DevHub.App.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels"
    xmlns:imaging="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:controls="using:DevHub.App.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid Margin="36,16,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Grid
            x:Name="HeroCard"
            Grid.Row="0"
            MinHeight="150"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            SizeChanged="HeroCard_SizeChanged">

            <!-- Decorative brand logos, gaussian-blurred with Win2D. -->
            <canvas:CanvasControl
                x:Name="LangDecor"
                Width="300"
                Height="300"
                Margin="8,0,0,-70"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Opacity="0.20"
                Draw="LangDecor_Draw"
                RenderTransformOrigin="0.5,0.5">
                <canvas:CanvasControl.RenderTransform>
                    <CompositeTransform x:Name="LangDecorTransform" Rotation="-10" />
                </canvas:CanvasControl.RenderTransform>
            </canvas:CanvasControl>
            <canvas:CanvasControl
                x:Name="IdeDecor"
                Width="240"
                Height="240"
                Margin="0,-50,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="0.20"
                Draw="IdeDecor_Draw"
                RenderTransformOrigin="0.5,0.5">
                <canvas:CanvasControl.RenderTransform>
                    <CompositeTransform x:Name="IdeDecorTransform" Rotation="10" />
                </canvas:CanvasControl.RenderTransform>
            </canvas:CanvasControl>

            <Grid x:Name="HeroContentGrid" Padding="24,24,224,24" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Uid="Detail_BackTip"
                    x:Name="BackButton"
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Click="Back_Click"
                    ToolTipService.ToolTip="Back to projects">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Name="ProjectName" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        x:Name="ProjectPath"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl x:Name="TechList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TechLine">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon}"
                                        Visibility="{x:Bind HasIcon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="ActionsRow" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <ComboBox
                            x:Name="IdePicker"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            SelectionChanged="IdePicker_SelectionChanged" />
                        <Button
                            x:Name="OpenInIdeButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OpenInIde_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                <TextBlock x:Uid="Detail_Open" Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="Detail_Explorer" Click="OpenInExplorer_Click" Content="Explorer" />
                        <Button
                            x:Name="RemoteButton"
                            Visibility="Collapsed"
                            Click="Remote_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image x:Name="RemoteIcon" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock x:Name="RemoteLabel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <!-- Declared last so it stays on top of the stretched hero text for hit-testing -->
            <StackPanel
                x:Name="HeroTopButtons"
                Margin="0,12,12,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="8">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                    <SplitButton
                        x:Uid="Detail_RunTip"
                        x:Name="RunButton"
                        Margin="0,0,4,0"
                        Click="Run_Click"
                        ToolTipService.ToolTip="Run this project in a terminal">
                        <!-- Lightweight styling: repaint every SplitButton state with the
                             accent-button brushes so hover/pressed stay on-brand. -->
                        <SplitButton.Resources>
                            <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                            <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                            <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                            <StaticResource x:Key="SplitButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorDisabledBrush" />
                            <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                            <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                            <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                            <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                        </SplitButton.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE768;" />
                            <TextBlock x:Name="RunButtonLabel" Text="Run" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="RunFlyout" Placement="BottomEdgeAlignedRight" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Uid="Detail_ManageSubprojectsTip" Click="ManageSubprojects_Click" ToolTipService.ToolTip="Manage subprojects">
                        <FontIcon FontSize="14" Glyph="&#xE71D;" />
                    </Button>
                    <Button x:Uid="Detail_RenameTip" Click="Rename_Click" ToolTipService.ToolTip="Rename project">
                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                    </Button>
                </StackPanel>

                <!-- Subproject shortcuts: regular buttons, folder + name + stack icons -->
                <ItemsControl x:Name="SubprojectsList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubprojectItem">
                            <Button
                                Width="200"
                                HorizontalContentAlignment="Stretch"
                                Click="Subproject_ButtonClick"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ItemsControl
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind Icons}"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind HasIcons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="imaging:SvgImageSource">
                                                <Image Width="13" Height="13" Source="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Section tabs -->
        <SelectorBar
            x:Name="SectionBar"
            Grid.Row="1"
            Margin="4,10,0,0"
            SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem x:Name="ReadmeTab" Text="README" IsSelected="True" />
            <SelectorBarItem x:Name="GitTab" Text="Git" Visibility="Collapsed" />
            <SelectorBarItem x:Uid="Detail_FilesTab" x:Name="FilesTab" Text="Files" />
            <!-- Text becomes "GitHub"/"GitLab"; only shown when the remote matches a connected account. -->
            <SelectorBarItem x:Name="ForgeTab" Text="GitHub" Visibility="Collapsed" />
        </SelectorBar>

        <!-- README -->
        <Grid x:Name="ReadmeContainer" Grid.Row="2" Margin="0,12,0,24">
            <Border
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <WebView2 x:Name="ReadmeView" Visibility="Collapsed" />
                    <TextBlock
                        x:Uid="Detail_NoReadme"
                        x:Name="NoReadmeText"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No README found in this project." />
                </Grid>
            </Border>
        </Grid>

        <!-- Git -->
        <Grid
            x:Name="GitContainer"
            Grid.Row="2"
            Margin="0,12,0,24"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="BranchPicker"
                    MinWidth="170"
                    VerticalAlignment="Center"
                    SelectionChanged="BranchPicker_SelectionChanged" />
                <Button x:Uid="Detail_NewBranchTip" x:Name="NewBranchButton" Click="NewBranch_Click" ToolTipService.ToolTip="Create a branch at HEAD and switch to it">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Detail_Branch" Text="Branch" />
                    </StackPanel>
                </Button>
                <Button x:Name="FetchButton" Click="Fetch_Click" ToolTipService.ToolTip="git fetch --all --prune">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE895;" />
                        <TextBlock Text="Fetch" />
                    </StackPanel>
                </Button>
                <Button x:Name="PullButton" Click="Pull_Click" ToolTipService.ToolTip="git pull">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock Text="Pull" />
                    </StackPanel>
                </Button>
                <Button x:Name="PushButton" Click="Push_Click" ToolTipService.ToolTip="git push">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                        <TextBlock Text="Push" />
                    </StackPanel>
                </Button>
                <ProgressRing
                    x:Name="GitBusyRing"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <TextBlock
                    x:Name="AheadBehindText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="GitCountsText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="GitStatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                x:Name="GitOpInfo"
                Grid.Row="1"
                IsOpen="False" />

            <!-- Commit graph -->
            <Border
                Grid.Row="2"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView x:Name="GraphList" SelectionMode="None" Padding="8,8,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphCommitRow">
                            <Grid ColumnSpacing="12" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <controls:CommitGraphCanvas
                                    Grid.Column="0"
                                    Width="{x:Bind GraphWidth}"
                                    Row="{x:Bind Row}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind ShortSha}" />
                                <ItemsControl
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind Refs}"
                                    Visibility="{x:Bind HasRefs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Padding="6,1"
                                                CornerRadius="8"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Message}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Author}" />
                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind WhenText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Files -->
        <Grid
            x:Name="FilesContainer"
            Grid.Row="2"
            Margin="0,12,0,24"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <TreeView
                    x:Name="FileTree"
                    Margin="4,8"
                    SelectionMode="Single"
                    Expanding="FileTree_Expanding"
                    ItemInvoked="FileTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileTreeNode">
                            <TreeViewItem
                                ItemsSource="{x:Bind Children}"
                                HasUnrealizedChildren="{x:Bind IsDirectory}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon}"
                                        Visibility="{x:Bind HasIcon}" />
                                    <FontIcon
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind ShowsGlyph}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border
                Grid.Column="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="Detail_FilePreviewHint"
                        x:Name="FileHeader"
                        Margin="16,12"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Select a file to preview it"
                        TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1">
                        <WebView2 x:Name="FileView" Visibility="Collapsed" />
                        <ScrollViewer
                            x:Name="FileFallbackScroll"
                            Padding="16,0,16,16"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock
                                    x:Name="FileContentText"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="12.5"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="NoWrap" />
                                <Image
                                    x:Name="FilePreviewImage"
                                    MaxWidth="900"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Forge (GitHub / GitLab) -->
        <Grid
            x:Name="ForgeContainer"
            Grid.Row="2"
            Margin="0,12,0,24"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Repo header -->
            <Border
                Grid.Row="0"
                Padding="16,12"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ForgeRepoName" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="ForgeRepoDescription"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <ProgressRing x:Name="ForgeLoading" Width="16" Height="16" IsActive="False" />
                        <TextBlock
                            x:Name="ForgeRepoStats"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        x:Name="ForgeOpenRepoButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="ForgeOpenRepo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                            <TextBlock x:Name="ForgeOpenRepoLabel" Text="Open on GitHub" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- PRs / issues / CI runs, side by side -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ForgePrsHeader"
                            Margin="16,12"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Open pull requests" />
                        <TextBlock
                            x:Uid="Detail_NothingOpen"
                            x:Name="ForgePrsEmpty"
                            Grid.Row="1"
                            Margin="16,0,16,16"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing open."
                            Visibility="Collapsed" />
                        <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ForgePrList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForgeItemViewModel">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind WebUrl}"
                                            Click="ForgeItem_Click"
                                            ToolTipService.ToolTip="{x:Bind WebUrl}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Octicon: git-pull-request (MIT, © GitHub) -->
                                                <Viewbox
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <Path
                                                        Fill="{x:Bind IconBrush}"
                                                        Data="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z" />
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            Visibility="{x:Bind IsDraft}">
                                                            <TextBlock
                                                                x:Uid="Detail_Draft"
                                                                FontSize="10"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="Draft" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind MetaText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ForgeIssuesHeader"
                            Margin="16,12"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Open issues" />
                        <TextBlock
                            x:Uid="Detail_NothingOpen"
                            x:Name="ForgeIssuesEmpty"
                            Grid.Row="1"
                            Margin="16,0,16,16"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing open."
                            Visibility="Collapsed" />
                        <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ForgeIssueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForgeItemViewModel">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind WebUrl}"
                                            Click="ForgeItem_Click"
                                            ToolTipService.ToolTip="{x:Bind WebUrl}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Octicon: issue-opened (MIT, © GitHub) -->
                                                <Viewbox
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <Path
                                                        Fill="{x:Bind IconBrush}"
                                                        Data="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z" />
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind MetaText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ForgeRunsHeader"
                            Margin="16,12"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Workflow runs" />
                        <TextBlock
                            x:Uid="Detail_NoRuns"
                            x:Name="ForgeRunsEmpty"
                            Grid.Row="1"
                            Margin="16,0,16,16"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No runs yet."
                            Visibility="Collapsed" />
                        <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ForgeRunList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForgeRunViewModel">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind WebUrl}"
                                            Click="ForgeItem_Click"
                                            ToolTipService.ToolTip="{x:Bind WebUrl}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status pill -->
                                                <Border
                                                    Grid.Column="0"
                                                    Padding="8,3"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="10"
                                                    Background="{x:Bind StatusBackground}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon
                                                            FontSize="11"
                                                            Glyph="{x:Bind StatusGlyph}"
                                                            Foreground="{x:Bind StatusBrush}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind StatusBrush}"
                                                            Text="{x:Bind StatusLabel}" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run FontWeight="SemiBold" Text="{x:Bind Name}" /><Run Text="  " /><Run Text="{x:Bind Title}" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind DetailText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind TimeText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
