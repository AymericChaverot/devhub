<Page
    x:Class="DevHub.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DevHub.App.Views">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPaletteAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="CommandPaletteAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged"
            Loaded="Nav_Loaded">
            <NavigationView.PaneCustomContent>
                <Button
                    x:Uid="Shell_QuickSearchBtn"
                    Margin="12,4,12,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Click="OpenCommandPalette_Click"
                    ToolTipService.ToolTip="Command palette (Ctrl+K)">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontSize="13" Glyph="&#xE721;" />
                        <TextBlock
                            x:Uid="Shell_QuickSearchLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Search…"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Ctrl+K" />
                    </Grid>
                </Button>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Shell_NavHome" Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavEnvironments" Content="Environments" Tag="environments">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavEnvVars" Content="Environment Variables" Tag="envvars">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavProjects" Content="Projects" Tag="projects">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavToolbox" Content="Toolbox" Tag="toolbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavPomodoro" Content="Pomodoro" Tag="pomodoro">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                    <!-- Global indicator: remaining minutes, visible even with the pane collapsed. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind Pomodoro.RemainingMinutes, Mode=OneWay}"
                            Visibility="{x:Bind Pomodoro.IsActive, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Global Command Palette overlay (Ctrl+K / Ctrl+P) -->
        <Grid
            x:Name="CommandPaletteOverlay"
            Background="#80000000"
            Visibility="Collapsed"
            Tapped="CommandPaletteBackdrop_Tapped">
            <Border
                Width="600"
                MaxHeight="480"
                Margin="0,72,0,0"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Tapped="CommandPaletteCard_Tapped">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Uid="Shell_PalettePlaceholder"
                        x:Name="CommandPaletteSearchBox"
                        Grid.Row="0"
                        PlaceholderText="Type a command, project, or tool… (Esc to close)"
                        TextChanged="CommandPaletteSearchBox_TextChanged"
                        PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown" />

                    <ListView
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="CommandPaletteList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:CommandPaletteItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="15"
                                        VerticalAlignment="Center"
                                        Glyph="{x:Bind Glyph}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Category}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
