<Page
    x:Class="DevHub.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels">

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="Proj_Title" Style="{StaticResource TitleTextBlockStyle}" Text="Projects" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ProjectsFolderPath, Mode=OneWay, FallbackValue=''}" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            Spacing="10"
            Visibility="{x:Bind ViewModel.HasProjectsFolder, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewProject_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Proj_NewProject" Text="New Project" />
                    </StackPanel>
                </Button>
                <Button Click="AddFromGit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEBD3;" />
                        <TextBlock x:Uid="Proj_AddFromGit" Text="Add from Git" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RescanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="Proj_Rescan" Text="Rescan" />
                    </StackPanel>
                </Button>
                <Button x:Uid="Proj_ChangeFolder" Click="ChangeFolder_Click" Content="Change folder…" />
                <StackPanel
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox
                    x:Uid="Proj_Search"
                    Width="280"
                    VerticalAlignment="Center"
                    PlaceholderText="Search projects…"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                <ComboBox
                    Width="220"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.TechnologyOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTechnology, Mode=TwoWay}" />
                <ComboBox
                    Width="195"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            CloseButtonClick="ErrorInfoBar_CloseButtonClick" />

        <!-- Empty state: no folder picked yet -->
        <StackPanel
            Grid.Row="3"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.NeedsFolderSelection, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Glyph="&#xE8B7;"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Uid="Proj_EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Choose your Projects folder" />
            <TextBlock
                x:Uid="Proj_EmptySubtitle"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="DevHub will scan it and list every project inside." />
            <Button
                x:Uid="Proj_ChooseFolder"
                HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Click="ChangeFolder_Click"
                Content="Choose folder" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="0,10,12,10"
            ItemsSource="{x:Bind ViewModel.Projects}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Project_ItemClick"
            Visibility="{x:Bind ViewModel.HasProjectsFolder, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectViewModel">
                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Glyph="&#xE8B7;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <FontIcon
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE9A6;"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind IsGitRepository}" />
                                <ItemsControl ItemsSource="{x:Bind Badges}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Badge">
                                            <Border
                                                Padding="7,2"
                                                CornerRadius="8"
                                                Background="{x:Bind Brush}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Image
                                                        Width="11"
                                                        Height="11"
                                                        VerticalAlignment="Center"
                                                        Source="{x:Bind Icon}"
                                                        Visibility="{x:Bind HasIcon}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Text}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Path}" />
                        </StackPanel>

                        <!--  Git at a glance: branch, uncommitted changes, commits to push / pull, then the host.  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                Visibility="{x:Bind HasGitStatus, Mode=OneWay}">
                                <TextBlock
                                    MaxWidth="160"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind BranchName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    ToolTipService.ToolTip="{x:Bind ChangesToolTip, Mode=OneWay}"
                                    Visibility="{x:Bind HasChanges, Mode=OneWay}">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ChangesText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind AheadText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind AheadToolTip, Mode=OneWay}"
                                    Visibility="{x:Bind HasAhead, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind BehindText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind BehindToolTip, Mode=OneWay}"
                                    Visibility="{x:Bind HasBehind, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RemoteHost}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Uid="Proj_PinButton"
                                VerticalAlignment="Center"
                                Click="TogglePin_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Pin / unpin project">
                                <FontIcon
                                    FontSize="14"
                                    Glyph="{x:Bind PinGlyph, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Button>
                            <Button
                                x:Uid="Proj_OpenExplorerButton"
                                VerticalAlignment="Center"
                                Click="OpenInExplorer_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Open in Explorer">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                x:Uid="Proj_MoreOptionsButton"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="More options">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="Proj_RemoveFromList"
                                            Click="RemoveFromList_Click"
                                            Tag="{x:Bind}"
                                            Text="Remove from list">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE738;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="Proj_DeleteFolder"
                                            Click="DeleteFolder_Click"
                                            Tag="{x:Bind}"
                                            Text="Delete folder…">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
