<Page
    x:Class="DevHub.App.Views.EnvVariablesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels">

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="EnvVar_Title" Style="{StaticResource TitleTextBlockStyle}" Text="Environment Variables" />
            <TextBlock
                x:Uid="EnvVar_Subtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Inspect and edit user and system variables. Changes are written to the registry and broadcast to running applications." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar x:Name="ScopeBar" Grid.Column="0" VerticalAlignment="Center" SelectionChanged="ScopeBar_SelectionChanged">
                    <SelectorBarItem x:Uid="EnvVar_UserTab" x:Name="UserTabItem" Text="User variables" IsSelected="True" />
                    <SelectorBarItem x:Uid="EnvVar_SystemTab" Text="System variables" />
                </SelectorBar>

                <AutoSuggestBox
                    x:Uid="EnvVar_Search"
                    Grid.Column="1"
                    MinWidth="200"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    PlaceholderText="Search by name or value"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

                <ProgressRing
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewVariable_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="EnvVar_New" Text="New variable" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="EnvVar_Refresh" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Click="Export_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock x:Uid="EnvVar_Export" Text="Export" />
                    </StackPanel>
                </Button>
                <Button Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                        <TextBlock x:Uid="EnvVar_Import" Text="Import" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="8">
            <InfoBar
                x:Uid="EnvVar_ElevationBar"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowElevationWarning, Mode=OneWay}"
                Title="Administrator rights required"
                Message="DevHub is not running as administrator. Saving a system variable will show a Windows elevation prompt for each change." />
            <InfoBar
                Severity="Error"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                CloseButtonClick="ErrorInfoBar_CloseButtonClick" />
            <InfoBar
                Severity="Success"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                CloseButtonClick="StatusInfoBar_CloseButtonClick" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Master: variable list -->
            <Border
                Grid.Column="0"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView
                    Padding="4"
                    ItemsSource="{x:Bind ViewModel.Variables, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedVariable, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EnvVariableItemViewModel">
                            <StackPanel Margin="0,6,0,6" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Value, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Detail: entry list or raw value editor -->
            <Border
                Grid.Column="1"
                Padding="16"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <TextBlock
                        x:Uid="EnvVar_NoSelection"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Select a variable to inspect or edit it."
                        Visibility="{x:Bind ViewModel.ShowPlaceholder, Mode=OneWay}" />

                    <Grid Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedVariable.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Click="DeleteVariable_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    <TextBlock x:Uid="EnvVar_Delete" Text="Delete" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Delimited variables (PATH, PATHEXT, …): one row per entry -->
                        <Grid Grid.Row="1" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowListEditor, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListView
                                Grid.Row="0"
                                Margin="-4,0,-4,0"
                                ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EnvPathEntryViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Path on the first line, warning badges below: the action
                                                 buttons keep their full width even with long paths. -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind Path}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind ExpandedPath}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border
                                                        Padding="6,2"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                        Visibility="{x:Bind IsMissing}">
                                                        <TextBlock
                                                            x:Uid="EnvVar_BadgeMissing"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                            Text="INVALID / NOT FOUND" />
                                                    </Border>
                                                    <Border
                                                        Padding="6,2"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        Visibility="{x:Bind IsDuplicate}">
                                                        <TextBlock
                                                            x:Uid="EnvVar_BadgeDuplicate"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                            Text="DUPLICATE" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    Click="CopyEntry_Click"
                                                    ToolTipService.ToolTip="Copy path">
                                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind IsOpenableFolder}"
                                                    Click="OpenEntry_Click"
                                                    ToolTipService.ToolTip="Open in Explorer">
                                                    <FontIcon FontSize="12" Glyph="&#xE838;" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    IsEnabled="{x:Bind CanMoveUp}"
                                                    Click="MoveUp_Click"
                                                    ToolTipService.ToolTip="Move up">
                                                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    IsEnabled="{x:Bind CanMoveDown}"
                                                    Click="MoveDown_Click"
                                                    ToolTipService.ToolTip="Move down">
                                                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    Click="EditEntry_Click"
                                                    ToolTipService.ToolTip="Edit entry">
                                                    <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Tag="{x:Bind}"
                                                    Click="DeleteEntry_Click"
                                                    ToolTipService.ToolTip="Delete entry">
                                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="AddEntry_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock x:Uid="EnvVar_AddEntry" Text="Add entry" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.RepairEntriesCommand}"
                                    Visibility="{x:Bind ViewModel.HasEntryWarnings, Mode=OneWay}"
                                    ToolTipService.ToolTip="Remove all invalid and duplicate entries">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE90F;" />
                                        <TextBlock x:Uid="EnvVar_Repair" Text="Repair" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Single-value variables: raw text editor -->
                        <Grid Grid.Row="1" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowTextEditor, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Uid="EnvVar_ValueBox"
                                Grid.Row="0"
                                Header="Value"
                                AcceptsReturn="False"
                                TextWrapping="Wrap"
                                Text="{x:Bind ViewModel.EditValueText, Mode=TwoWay}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SaveValueCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                        <TextBlock x:Uid="Common_Save" Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button Click="CopyValue_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock x:Uid="EnvVar_CopyValue" Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="OpenValue_Click"
                                    Visibility="{x:Bind ViewModel.SelectedValueIsFolder, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                        <TextBlock x:Uid="EnvVar_OpenExplorer" Text="Open in Explorer" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
