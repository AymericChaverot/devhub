<Page
    x:Class="DevHub.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels">

    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Grid">
            <Setter Property="Padding" Value="16" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="36,24,36,36" Spacing="8" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!-- ============ General ============ -->
            <TextBlock x:Uid="Settings_GeneralHeader" Style="{StaticResource SectionHeader}" Text="General" />

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xE8B7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="Settings_ProjectsFolderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Projects folder" />
                    <TextBlock
                        x:Name="FolderPathText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Not set" />
                </StackPanel>
                <Button x:Uid="Settings_ChangeButton" Grid.Column="2" VerticalAlignment="Center" Click="ChangeFolder_Click" Content="Change…" />
            </Grid>

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xE753;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="Settings_WeatherTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Weather location" />
                    <TextBlock
                        x:Uid="Settings_WeatherHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="City shown on the dashboard. Leave empty to locate automatically from your IP." />
                </StackPanel>
                <TextBox
                    x:Uid="Settings_WeatherBox"
                    x:Name="WeatherLocationBox"
                    Grid.Column="2"
                    Width="220"
                    VerticalAlignment="Center"
                    PlaceholderText="Automatic"
                    LostFocus="WeatherLocation_LostFocus"
                    KeyDown="WeatherLocation_KeyDown" />
            </Grid>

            <!-- ============ Appearance ============ -->
            <TextBlock x:Uid="Settings_AppearanceHeader" Style="{StaticResource SectionHeader}" Text="Appearance" />

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xE790;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="Settings_ThemeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Theme" />
                    <TextBlock
                        x:Uid="Settings_ThemeHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose how DevHub looks" />
                </StackPanel>
                <ComboBox
                    x:Name="ThemePicker"
                    Grid.Column="2"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    SelectionChanged="ThemePicker_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_ThemeSystem" Content="Use system setting" Tag="System" />
                    <ComboBoxItem x:Uid="Settings_ThemeLight" Content="Light" Tag="Light" />
                    <ComboBoxItem x:Uid="Settings_ThemeDark" Content="Dark" Tag="Dark" />
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xF2B7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="Settings_LanguageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Language" />
                    <TextBlock
                        x:Uid="Settings_LanguageHint"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Takes effect after restarting DevHub" />
                </StackPanel>
                <ComboBox
                    x:Name="LanguagePicker"
                    Grid.Column="2"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    SelectionChanged="LanguagePicker_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_LanguageSystem" Content="Use system setting" Tag="System" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="Français" Tag="fr-FR" />
                </ComboBox>
            </Grid>

            <!-- ============ Accounts ============ -->
            <TextBlock x:Uid="Settings_AccountsHeader" Style="{StaticResource SectionHeader}" Text="Accounts" />

            <ItemsControl ItemsSource="{x:Bind Accounts.Accounts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ForgeAccountViewModel">
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Width="26"
                                Height="26"
                                VerticalAlignment="Center"
                                Source="{x:Bind IconImage}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind TokenScopeHint}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind IsDisconnected, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasError, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Disconnected: token entry -->
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsDisconnected, Mode=OneWay}">
                                <HyperlinkButton
                                    x:Uid="Settings_CreateToken"
                                    VerticalAlignment="Center"
                                    NavigateUri="{x:Bind TokenHelpUri}"
                                    Content="Create a token" />
                                <PasswordBox
                                    x:Uid="Settings_TokenBox"
                                    Width="240"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Personal access token"
                                    Password="{x:Bind TokenInput, Mode=TwoWay}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                <Button
                                    x:Uid="Settings_ConnectButton"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Connect"
                                    Command="{x:Bind SubmitTokenCommand}" />
                            </StackPanel>

                            <!-- Connected: identity + disconnect -->
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsConnected, Mode=OneWay}">
                                <PersonPicture
                                    Width="32"
                                    Height="32"
                                    DisplayName="{x:Bind Login, Mode=OneWay}"
                                    ProfilePicture="{x:Bind AvatarImage, Mode=OneWay}" />
                                <Button
                                    x:Uid="Settings_DisconnectButton"
                                    VerticalAlignment="Center"
                                    Content="Disconnect"
                                    Command="{x:Bind DisconnectCommand}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Data ============ -->
            <TextBlock x:Uid="Settings_DataHeader" Style="{StaticResource SectionHeader}" Text="Data" />

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xE838;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="Settings_AppDataTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="App data" />
                    <TextBlock
                        x:Name="DataFolderText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Uid="Settings_OpenLogs" Grid.Column="2" VerticalAlignment="Center" Click="OpenLogs_Click" Content="Open logs" />
                <Button x:Uid="Settings_OpenFolder" Grid.Column="3" VerticalAlignment="Center" Click="OpenDataFolder_Click" Content="Open folder" />
            </Grid>

            <!-- ============ About ============ -->
            <TextBlock x:Uid="Settings_AboutHeader" Style="{StaticResource SectionHeader}" Text="About" />

            <Grid Style="{StaticResource SettingsCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="8">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.png" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="DevHub" />
                    <TextBlock
                        x:Name="VersionText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Built with WinUI 3 (Windows App SDK 2.2) and .NET 10" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Updates.StatusText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind Updates.IsChecking, Mode=OneWay}"
                        Visibility="{x:Bind Updates.IsChecking, Mode=OneWay}" />
                    <Button
                        x:Uid="Settings_CheckUpdates"
                        Content="Check for updates"
                        Command="{x:Bind Updates.CheckCommand}" />
                    <Button
                        x:Uid="Settings_InstallUpdate"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Install update"
                        Command="{x:Bind Updates.InstallCommand}"
                        Visibility="{x:Bind Updates.CanInstall, Mode=OneWay}"
                        IsEnabled="{x:Bind Updates.CanInstallNow, Mode=OneWay}" />
                    <HyperlinkButton
                        x:Uid="Settings_GitHubRepo"
                        VerticalAlignment="Center"
                        NavigateUri="https://github.com/AymericChaverot/devhub"
                        Content="GitHub repository" />
                </StackPanel>
            </Grid>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,12">
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE90F;" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Settings_LicensesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Open-source licenses" />
                            <TextBlock
                                x:Uid="Settings_LicensesHint"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Third-party components used by DevHub" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8" Padding="8,4">
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Windows App SDK / WinUI 3" /><Run Text=" — MIT License, © Microsoft Corporation" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="CommunityToolkit.Mvvm" /><Run Text=" — MIT License, © .NET Foundation" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Microsoft.Extensions.DependencyInjection" /><Run Text=" — MIT License, © Microsoft Corporation" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Serilog &amp; Serilog.Sinks.File" /><Run Text=" — Apache License 2.0" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="LibGit2Sharp" /><Run Text=" — MIT License (links libgit2, GPLv2 with linking exception)" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Microsoft.Data.Sqlite" /><Run Text=" — MIT License; SQLite itself is public domain" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Markdig" /><Run Text=" — BSD 2-Clause License, © Alexandre Mutel" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Win2D (Microsoft.Graphics.Win2D)" /><Run Text=" — MIT License, © Microsoft Corporation" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Simple Icons" /><Run Text=" — CC0 1.0; all brand logos are trademarks of their respective owners" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Octicons" /><Run Text=" — MIT License, © GitHub, Inc. (pull request / issue glyphs)" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Devicon" /><Run Text=" — MIT License (Java logo)" /></TextBlock>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
