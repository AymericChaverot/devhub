<Page
    x:Class="DevHub.App.Views.PomodoroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevHub.App.ViewModels">

    <ScrollViewer>
        <Grid Margin="36,24,36,24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Pomodoro" />
                <TextBlock
                    x:Uid="Pomo_Subtitle"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Focused work sessions with a notification when time is up. The timer keeps running while you use the rest of the app." />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">

                <!-- The dial -->
                <Grid HorizontalAlignment="Center">
                    <ProgressRing
                        Width="220"
                        Height="220"
                        IsIndeterminate="False"
                        Maximum="100"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="46"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.TimeText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
                        <FontIcon
                            FontSize="46"
                            Glyph="&#xE823;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SessionLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- Active controls -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}">
                    <Button
                        MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TogglePauseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PauseTooltip, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="120" Command="{x:Bind ViewModel.StopCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            <TextBlock x:Uid="Pomo_Stop" Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Idle: presets + custom + optional project link -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button
                            x:Uid="Pomo_Focus25"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Focus · 25 min"
                            Tag="25|focus"
                            Click="Preset_Click" />
                        <Button x:Uid="Pomo_Focus50" Content="Focus · 50 min" Tag="50|focus" Click="Preset_Click" />
                        <Button x:Uid="Pomo_Break5" Content="Break · 5 min" Tag="5|break" Click="Preset_Click" />
                        <Button x:Uid="Pomo_Break15" Content="Break · 15 min" Tag="15|break" Click="Preset_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <NumberBox
                            x:Uid="Pomo_CustomMinutes"
                            x:Name="CustomMinutes"
                            Header="Minutes"
                            Width="130"
                            Minimum="1"
                            Maximum="240"
                            Value="25"
                            SpinButtonPlacementMode="Compact" />
                        <TextBox
                            x:Uid="Pomo_CustomLabel"
                            x:Name="CustomLabel"
                            Header="Label"
                            Width="150"
                            Text="Focus" />
                        <ComboBox
                            x:Uid="Pomo_ProjectPicker"
                            Header="Project"
                            MinWidth="180"
                            ItemsSource="{x:Bind ViewModel.ProjectOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProjectOption, Mode=TwoWay}" />
                        <Button
                            x:Uid="Pomo_Start"
                            VerticalAlignment="Bottom"
                            Content="Start"
                            Click="CustomStart_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Stats & History -->
            <Grid Grid.Row="2" MaxWidth="760" HorizontalAlignment="Stretch" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Uid="Pomo_TodayHeader"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="FOCUS TODAY" />
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.TodaySummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Uid="Pomo_WeekHeader"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="LAST 7 DAYS" />
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.WeekSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="16"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="Pomo_HistoryHeader"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Recent sessions" />
                            <Button
                                x:Uid="Pomo_ClearHistory"
                                Grid.Column="1"
                                Content="Clear"
                                Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PomodoroHistoryItem">
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Title}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,2"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{x:Bind HasProject}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind ProjectBadge}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DurationText}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind WhenText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
